{
    "name": "mbolli/php-ron-playground",
    "description": "Live RON playground: a php-via app that converts JSON <-> RON on keypress over a single SSE connection.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-openswoole": "^26.0",
        "mbolli/php-via": "@dev",
        "mbolli/php-ron": "^0.5.0",
        "tempest/highlight": "^2.17",
        "mbolli/tempest-highlight-ron": "^1.0.2"
    },
    "autoload": {
        "psr-4": {
            "RonPlayground\\": "src/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "start": "@php app.php"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-via-014",
            "options": {
                "symlink": true
            }
        }
    ]
}
